---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const preview = import.meta.env.PREVIEW_CONTENT === 'true';
  const entries = (await getCollection('destinations')).filter((entry) =>
    entry.data.status === 'published' || (preview && entry.data.status === 'review')
  );
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ArticleLayout data={entry.data}>
  <Content />
</ArticleLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/content/ArticleCard.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).filter((entry) => entry.data.status === 'published');
const decisions = (await getCollection('decisions')).filter((entry) => entry.data.status === 'published');
---
<BaseLayout>
  <section class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Redaktionelle Reiseauswahl</p>
        <h1>Nicht mehr sehen.<br /><em>Besser auswählen.</em></h1>
        <p class="lead">Für alle, die ihre Reise selbst planen möchten – aber nicht jede Entscheidung allein und unsicher treffen wollen.</p>
        <p class="hero-trust">Redaktionell kuratiert. Quellen geprüft. Trade-offs sichtbar. Vor Veröffentlichung freigegeben.</p>
        <div class="hero-actions">
          <a class="button" href="#auswahl">Ausgewählte Reisen</a>
          <a class="button button--ghost" href="/methodik/">Wie wir auswählen</a>
        </div>
        <div class="hero-proof">
          <span>Klare Prioritäten</span>
          <span>bewusste Auslassungen</span>
          <span>nachvollziehbare Quellen</span>
        </div>
      </div>
      <div class="home-hero__visual">
        <!-- PLACEHOLDER: real image pending, slug=home -->
        <img src="/images/hero-editorial.svg" alt="Abstrakte redaktionelle Reisecollage" fetchpriority="high" />
        <div class="hero-note">
          <span class="label">Orientierung</span>
          <strong>Was lohnt sich wirklich?</strong>
          <p>Wir gewichten nach Interesse, Zeit, Route und Komfort – nicht nach Anzahl der Sehenswürdigkeiten.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container editorial-intro">
      <p class="eyebrow">Für selbstorganisierte Reisen</p>
      <h2>Wir treffen die Vorauswahl. Du behältst die Entscheidung.</h2>
      <p>Keine „50 Dinge, die du gesehen haben musst“. Stattdessen: wenige starke Optionen, sichtbare Trade-offs und klare Hinweise, wann wir für ein anderes Reiseprofil anders entscheiden würden.</p>
    </div>
  </section>

  <section id="auswahl" class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Ausgewählte Reisen</p>
        <h2>Mit einem klaren Profil geplant</h2>
      </div>
      <a class="text-link" href="/reiseziele/">Alle Reiseziele →</a>
    </div>
    <div class="article-grid">
      {guides.map((entry) => (
        <ArticleCard
          href={'/guides/' + entry.data.slug + '/'}
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.heroImage?.src}
          kicker="Guide"
          meta={entry.data.duration.ideal + ' Tage'}
        />
      ))}
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-heading section-heading--light">
        <div>
          <p class="eyebrow">Konkrete Entscheidungen</p>
          <h2>Die Fragen, an denen Reiseplanung hängen bleibt.</h2>
        </div>
      </div>
      <div class="decision-row">
        {decisions.map((entry) => (
          <a class="decision-card" href={'/decisions/' + entry.data.slug + '/'}>
            <span class="label">Entscheidung</span>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <span class="text-link text-link--light">Entscheidung ansehen →</span>
          </a>
        ))}
        <div class="decision-card decision-card--quiet">
          <span class="label">Prinzip</span>
          <h3>Weglassen ist Teil der Planung.</h3>
          <p>Eine komfortable Reise wird nicht besser, nur weil noch ein Ort in die Route passt.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Interessen</p>
        <h2>Die Reise folgt deinem Schwerpunkt.</h2>
      </div>
      <a class="text-link" href="/interessen/">Alle Interessen →</a>
    </div>
    <div class="interest-grid">
      {[
        ['Kunst & Kultur','Museen, Sammlungen und kulturelle Orte gezielt priorisieren.'],
        ['Geschichte','Orte nach historischer Relevanz statt Bekanntheit auswählen.'],
        ['Architektur','Bauwerke, Stadtbilder und Epochen sinnvoll kombinieren.'],
        ['Natur & Wandern','Aktivität und Komfort in ein realistisches Tempo bringen.'],
        ['Genuss','Kulinarik als Teil der Route statt als beliebige Zusatzliste.']
      ].map(([name, text], index) => (
        <div class="interest-card">
          <span>{String(index + 1).padStart(2,'0')}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <div class="method-panel">
      <div>
        <p class="eyebrow">So arbeiten wir</p>
        <h2>Recherche → Auswahl → Begründung.</h2>
      </div>
      <div class="method-steps">
        <div><span>01</span><strong>Fakten prüfen</strong><p>Offizielle Quellen zuerst, Erfahrungsquellen ergänzend.</p></div>
        <div><span>02</span><strong>Trade-offs bewerten</strong><p>Zeit, Relevanz, Wege und Komfort gegeneinander abwägen.</p></div>
        <div><span>03</span><strong>Entscheidung sichtbar machen</strong><p>Priorität, optional und bewusst weglassen.</p></div>
      </div>
      <a class="button button--ghost-dark" href="/methodik/">Redaktionelle Methodik</a>
    </div>
  </section>
</BaseLayout>

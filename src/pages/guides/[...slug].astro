---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ParisExperienceLayout from '../../layouts/ParisExperienceLayout.astro';
import WalkingExperienceLayout from '../../layouts/WalkingExperienceLayout.astro';
import { walkingExperiences } from '../../data/experiences/walking';

export async function getStaticPaths() {
  const preview = import.meta.env.PREVIEW_CONTENT === 'true';
  const entries = (await getCollection('guides')).filter((entry) =>
    entry.data.status === 'published' || (preview && entry.data.status === 'review')
  );
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const walkingExperience = walkingExperiences[entry.data.slug];
---
{entry.data.slug === 'paris-kunst-4-tage' ? (
  <ParisExperienceLayout data={entry.data}>
    <Content />
  </ParisExperienceLayout>
) : walkingExperience ? (
  <WalkingExperienceLayout data={entry.data} experience={walkingExperience}>
    <Content />
  </WalkingExperienceLayout>
) : (
  <ArticleLayout data={entry.data}>
    <Content />
  </ArticleLayout>
)}

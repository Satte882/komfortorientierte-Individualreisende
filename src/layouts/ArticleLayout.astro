---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ArticleMeta from '../components/content/ArticleMeta.astro';
import MethodologyNote from '../components/content/MethodologyNote.astro';
import SourceList from '../components/content/SourceList.astro';

const { data } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: new Date(data.datePublished).toISOString(),
  dateModified: new Date(data.dateReviewed).toISOString(),
  inLanguage: 'de-DE'
};
const typeLabel = data.type === 'decision' ? 'Reiseentscheidung' : data.type === 'guide' ? 'Kuratierter Guide' : 'Reiseziel';
---
<BaseLayout
  title={data.title}
  description={data.description}
  jsonLd={jsonLd}
  noindex={data.status !== 'published'}
>
  <Breadcrumbs items={[{ label: data.title }]} />
  <header class="article-hero container">
    <div class="article-hero__copy">
      <p class="eyebrow">{typeLabel}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <ArticleMeta datePublished={data.datePublished} dateReviewed={data.dateReviewed} duration={data.duration} />
      <div class="tag-row">
        {data.interests.map((interest: string) => <span class="tag">{interest}</span>)}
        <span class="tag tag--muted">komfortorientiert</span>
      </div>
    </div>
    <figure class="article-hero__visual">
      {data.heroImage ? (
        <>
          <img src={data.heroImage.src} alt={data.heroImage.alt} loading="eager" />
          <figcaption>{data.heroImage.source} · {data.heroImage.license}</figcaption>
        </>
      ) : <div class="visual-placeholder visual-placeholder--large" aria-hidden="true"></div>}
    </figure>
  </header>
  <article class="prose article-body">
    <slot />
    <MethodologyNote />
    <SourceList sources={data.sources} />
  </article>
</BaseLayout>

---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ConsentManager from '../components/client/ConsentManager.astro';
import TrackingClient from '../components/client/TrackingClient.astro';
import '../styles/global.css';
import { site } from '../data/site';

const {
  title = site.name,
  description = site.description,
  canonical,
  noindex = false,
  jsonLd
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <ConsentManager />
    <TrackingClient />
    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest('[data-open-consent]')) {
          window.dispatchEvent(new CustomEvent('consent:open'));
        }
      });
    </script>
  </body>
</html>

---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ArticleMeta from '../components/content/ArticleMeta.astro';
import MethodologyNote from '../components/content/MethodologyNote.astro';
import SourceList from '../components/content/SourceList.astro';

const { data } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: new Date(data.datePublished).toISOString(),
  dateModified: new Date(data.dateReviewed).toISOString(),
  inLanguage: 'de-DE'
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  jsonLd={jsonLd}
  noindex={data.status !== 'published'}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://tiles.openfreemap.org" />
    <link rel="preconnect" href="https://unpkg.com" />
    <link
      rel="stylesheet"
      href="https://unpkg.com/maplibre-gl@6.10.0/dist/maplibre-gl.css"
    />
  </Fragment>

  <div class="paris-experience" data-paris-experience>
    <section class="paris-cinematic-hero" aria-labelledby="paris-hero-title">
      <img
        class="paris-cinematic-hero__fallback"
        src="/images/paris-spike/paris-seine-sunset.webp"
        alt="Paris an der Seine bei Sonnenuntergang"
        width="1800"
        height="1350"
        loading="eager"
        fetchpriority="high"
      />
      <video
        class="paris-cinematic-hero__video"
        data-paris-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster="/images/paris-spike/paris-seine-sunset.webp"
        aria-hidden="true"
      >
        <source
          data-paris-hero-source
          data-src="/videos/paris-spike/paris-hero.mp4"
          type="video/mp4"
        />
      </video>
      <div class="paris-cinematic-hero__scrim" aria-hidden="true"></div>
      <div class="paris-cinematic-hero__content container">
        <Breadcrumbs items={[{ label: data.title }]} />
        <p class="eyebrow">Kuratierter Kunst-Guide · Paris</p>
        <h1 id="paris-hero-title">{data.title}</h1>
        <p class="paris-cinematic-hero__lead">{data.description}</p>
        <div class="paris-cinematic-hero__meta">
          <ArticleMeta
            datePublished={data.datePublished}
            dateReviewed={data.dateReviewed}
            duration={data.duration}
          />
          <span>3 Kernmuseen · bewusst priorisiert</span>
        </div>
        <a class="paris-cinematic-hero__jump" href="#paris-story">
          Reiseentscheidung erleben
          <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="paris-cinematic-hero__credit">
        Video:
        <a href="https://commons.wikimedia.org/wiki/File:Paris,_river_Seine102817.webm">Quahadi</a>
        · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>
        · gekürzt, ohne Ton · Foto-Fallback: Raphael Desrosiers · CC BY 2.0
      </p>
    </section>

    <section class="paris-experience__intro container">
      <p class="eyebrow">Unser Prinzip</p>
      <p>
        Drei Kunstanker, ein geschützter Flex-Tag und genug Luft für Paris selbst.
        Die Visualisierung folgt den Entscheidungen des Guides – <strong>nicht umgekehrt</strong>.
      </p>
    </section>

    <div class="paris-story container" id="paris-story">
      <aside class="paris-stage" aria-label="Visuelle Begleitung des Paris-Guides">
        <div class="paris-stage__frame">
          <div class="paris-stage__media" aria-live="polite">
            <figure class="paris-stage__image paris-stage__image--collage is-active" data-media="overview">
              <div class="paris-stage__collage" aria-label="Orsay, Louvre und Orangerie">
                <img src="/images/paris-spike/orsay.webp" alt="Musée d'Orsay" loading="eager" />
                <img src="/images/paris-spike/louvre.webp" alt="Louvre" loading="eager" />
                <img src="/images/paris-spike/orangerie.webp" alt="Musée de l'Orangerie" loading="eager" />
              </div>
              <figcaption>Unsere drei Kunstanker · Orsay · Louvre · Orangerie</figcaption>
            </figure>
            <figure class="paris-stage__image" data-media="paris" aria-hidden="true">
              <img
                src="/images/paris-spike/paris-seine-sunset.webp"
                alt="Paris an der Seine bei Sonnenuntergang"
                loading="lazy"
              />
              <figcaption>Paris · Raum für Pause und Flexibilität</figcaption>
            </figure>
            <figure class="paris-stage__image" data-media="orsay" aria-hidden="true">
              <img
                src="/images/paris-spike/orsay.webp"
                alt="Frontansicht des Musée d'Orsay in Paris"
                loading="lazy"
              />
              <figcaption>Musée d'Orsay · Foto: DiscoA340 · CC BY-SA 4.0</figcaption>
            </figure>
            <figure class="paris-stage__image" data-media="louvre" aria-hidden="true">
              <img
                src="/images/paris-spike/louvre.webp"
                alt="Musée du Louvre im Abendlicht"
                loading="lazy"
              />
              <figcaption>Louvre · Foto: DiscoA340 · CC BY-SA 4.0</figcaption>
            </figure>
            <figure class="paris-stage__image" data-media="orangerie" aria-hidden="true">
              <img
                src="/images/paris-spike/orangerie.webp"
                alt="Außenansicht des Musée de l'Orangerie in Paris"
                loading="lazy"
              />
              <figcaption>Musée de l'Orangerie · Foto: John Samuel · CC BY-SA 4.0</figcaption>
            </figure>
            <figure class="paris-stage__image" data-media="marmottan" aria-hidden="true">
              <img
                src="/images/paris-spike/marmottan.webp"
                alt="Außenansicht des Musée Marmottan Monet in Paris"
                loading="lazy"
              />
              <figcaption>Musée Marmottan Monet · Pierre André Leclercq · CC BY-SA 4.0</figcaption>
            </figure>
          </div>

          <div class="paris-stage__map-wrap">
            <div
              class="paris-stage__map"
              data-paris-map
              role="region"
              aria-label="Interaktive Karte der priorisierten Kunstorte in Paris"
            >
              <div class="paris-stage__map-placeholder">
                <span>Karte wird bei Bedarf geladen</span>
              </div>
            </div>
            <div class="paris-stage__route-label">
              Redaktionelle Abfolge · keine Navigationsroute
            </div>
          </div>

          <div class="paris-decision" data-paris-decision>
            <span class="paris-decision__status" data-decision-status>Unsere Auswahl</span>
            <strong data-decision-title>Orsay → Louvre → Orangerie → Flex</strong>
            <p data-decision-copy>
              Drei Kunstanker strukturieren die Reise. Der vierte Tag bleibt bewusst als Puffer geschützt.
            </p>
          </div>
        </div>

        <div class="paris-stage__legend" aria-label="Kartenlegende">
          <span><i class="paris-dot paris-dot--priority"></i> Priorität</span>
          <span><i class="paris-dot paris-dot--optional"></i> Optional</span>
          <span><i class="paris-dot paris-dot--skip"></i> Bewusst weglassen</span>
        </div>

        <div class="paris-poi-list" aria-label="Priorisierte Kunstorte">
          <button type="button" class="paris-poi-card" data-poi-jump="orsay">
            <img src="/images/paris-spike/orsay.webp" alt="" loading="lazy" />
            <span><small>Priorität</small><strong>Musée d'Orsay</strong></span>
          </button>
          <button type="button" class="paris-poi-card" data-poi-jump="louvre">
            <img src="/images/paris-spike/louvre.webp" alt="" loading="lazy" />
            <span><small>Priorität</small><strong>Louvre</strong></span>
          </button>
          <button type="button" class="paris-poi-card" data-poi-jump="orangerie">
            <img src="/images/paris-spike/orangerie.webp" alt="" loading="lazy" />
            <span><small>Priorität</small><strong>Orangerie</strong></span>
          </button>
        </div>
      </aside>

      <article class="prose article-body paris-story__copy" data-paris-story-copy>
        <slot />
        <MethodologyNote />
        <SourceList sources={data.sources} />
      </article>
    </div>
  </div>

  <script is:inline type="module">
    const experience = document.querySelector('[data-paris-experience]');

    if (experience) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = Boolean(navigator.connection?.saveData);
      const heroVideo = experience.querySelector('[data-paris-hero-video]');
      const heroSource = experience.querySelector('[data-paris-hero-source]');
      const mediaItems = [...experience.querySelectorAll('[data-media]')];
      const decisionStatus = experience.querySelector('[data-decision-status]');
      const decisionTitle = experience.querySelector('[data-decision-title]');
      const decisionCopy = experience.querySelector('[data-decision-copy]');
      const mapContainer = experience.querySelector('[data-paris-map]');

      const places = {
        orsay: {
          id: 'orsay',
          name: "Musée d'Orsay",
          center: [2.3259, 48.8600]
        },
        louvre: {
          id: 'louvre',
          name: 'Louvre',
          center: [2.3364, 48.8606]
        },
        orangerie: {
          id: 'orangerie',
          name: "Musée de l'Orangerie",
          center: [2.3226, 48.8638]
        },
        marmottan: {
          id: 'marmottan',
          name: 'Musée Marmottan Monet',
          center: [2.2672, 48.8593]
        }
      };

      const routeOrder = ['orsay', 'louvre', 'orangerie'];
      const routeCoordinates = routeOrder.map((key) => places[key].center);

      const stageStates = {
        overview: {
          media: 'overview',
          role: 'Unsere Auswahl',
          title: 'Orsay → Louvre → Orangerie → Flex',
          copy: 'Drei Kunstanker strukturieren die Reise. Der vierte Tag bleibt bewusst als Puffer geschützt.',
          map: { view: 'core', focus: null, route: 'full' }
        },
        profile: {
          media: 'overview',
          role: 'Für dieses Profil',
          title: 'Kunst sehen – nicht Museen sammeln',
          copy: 'Ein fordernder Kunstblock pro Tag. Danach Paris, Pause und freie Zeit.',
          map: { view: 'core', focus: null, route: 'full' }
        },
        orsay: {
          media: 'orsay',
          role: 'Priorität 1',
          title: "Musée d'Orsay",
          copy: 'Höchste Profilpassung für Impressionismus und Kunst des 19. Jahrhunderts – als eigener, konzentrierter Museumsblock.',
          map: { view: 'core', focus: 'orsay', route: 0 }
        },
        louvre: {
          media: 'louvre',
          role: 'Priorität 2',
          title: 'Louvre',
          copy: 'Unbedingt – aber mit vorher gewähltem Schwerpunkt statt als Vollständigkeitsprojekt.',
          map: { view: 'core', focus: 'louvre', route: 1 }
        },
        orangerie: {
          media: 'orangerie',
          role: 'Priorität 3',
          title: "Musée de l'Orangerie",
          copy: 'Der bewusst leichtere dritte Kunstanker: kompakter, fokussierter und gut mit den Tuilerien kombinierbar.',
          map: { view: 'core', focus: 'orangerie', route: 2 }
        },
        plan: {
          media: 'overview',
          role: '4-Tage-Struktur',
          title: 'Orsay → Louvre → Orangerie → Flex',
          copy: 'Die drei Kernmuseen bekommen je ihren eigenen Rhythmus. Tag vier bleibt Risikopuffer statt Pflichtprogramm.',
          map: { view: 'core', focus: null, route: 'full' }
        },
        versailles: {
          media: 'overview',
          role: 'Bewusst weglassen',
          title: 'Versailles',
          copy: 'Bei vier Tagen und engem Malerei-Fokus investieren wir die Zeit lieber in die drei Kernanker und in Paris selbst.',
          map: { view: 'core', focus: null, route: 'full' }
        },
        pompidou: {
          media: 'overview',
          role: 'Aktuell weglassen',
          title: 'Centre Pompidou',
          copy: '2026 nicht als normalen Museumsstop einplanen. Die drei Kernanker bleiben die belastbare Basis.',
          map: { view: 'core', focus: null, route: 'full' }
        },
        marmottan: {
          media: 'marmottan',
          role: 'Optional',
          title: 'Musée Marmottan Monet',
          copy: 'Als vierter Kunstbaustein nur bei echtem Monet-Spezialinteresse – räumlich deutlich außerhalb der Kernroute.',
          map: { view: 'all', focus: 'marmottan', route: 'full' }
        },
        flex: {
          media: 'paris',
          role: 'Flex-Puffer',
          title: 'Tag D hält die Reise beweglich',
          copy: 'Verpasste Slots, Wetter oder Müdigkeit werden aufgefangen, ohne einen Kunsttag zu überladen.',
          map: { view: 'core', focus: null, route: 'full' }
        },
        stay: {
          media: 'paris',
          role: 'Komfortentscheidung',
          title: 'Lage schlägt Romantik',
          copy: 'Kurze, einfache Wege zur Seine-Achse sind für diesen Guide wichtiger als die spektakulärste Adresse.',
          map: { view: 'core', focus: null, route: 'full' }
        },
        precheck: {
          media: 'overview',
          role: 'Vor der Reise',
          title: 'Öffnungstage und Slots zuerst',
          copy: 'Die Reihenfolge bleibt flexibel. Entscheidend sind aktuelle Öffnungstage, Zeitfenster und Sonderausstellungen.',
          map: { view: 'core', focus: null, route: 'full' }
        },
        final: {
          media: 'overview',
          role: 'Unsere Entscheidung',
          title: 'Drei Kunstanker. Ein Flex-Tag.',
          copy: 'Orsay priorisieren, Louvre kuratieren, Orangerie leicht halten und den vierten Tag bewusst schützen.',
          map: { view: 'core', focus: null, route: 'full' }
        }
      };

      const chapterStates = [
        { match: /für wen wir hier entscheiden/i, key: 'profile' },
        { match: /musée d[’']orsay/i, key: 'orsay' },
        { match: /louvre:/i, key: 'louvre' },
        { match: /orangerie:/i, key: 'orangerie' },
        { match: /so würden wir vier tage tatsächlich aufbauen/i, key: 'plan' },
        { match: /^versailles$/i, key: 'versailles' },
        { match: /centre pompidou/i, key: 'pompidou' },
        { match: /monet dein spezialinteresse/i, key: 'marmottan' },
        { match: /plan b:/i, key: 'flex' },
        { match: /wo würden wir übernachten/i, key: 'stay' },
        { match: /was vor der reise noch einmal prüfen/i, key: 'precheck' },
        { match: /unsere entscheidung in einem satz/i, key: 'final' }
      ];

      let map;
      let maplibregl;
      let routeSource;
      let routeAnimationFrame = null;
      let mapReady = false;
      let activeStateKey = 'overview';
      let activeStoryElement = null;
      let storyTicking = false;

      if (heroVideo && heroSource && !reducedMotion && !saveData) {
        heroSource.src = heroSource.dataset.src;
        heroVideo.load();
        heroVideo.addEventListener('canplay', () => {
          heroVideo.classList.add('is-ready');
          heroVideo.play().catch(() => {});
        }, { once: true });
      }

      function setMedia(key) {
        mediaItems.forEach((item) => {
          const active = item.getAttribute('data-media') === key;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
      }

      function setDecision(state) {
        if (decisionStatus) decisionStatus.textContent = state.role;
        if (decisionTitle) decisionTitle.textContent = state.title;
        if (decisionCopy) decisionCopy.textContent = state.copy;
        const decision = experience.querySelector('[data-paris-decision]');
        if (decision) decision.setAttribute('data-role', state.role.toLowerCase());
      }

      function boundsFor(coordinates) {
        return coordinates.reduce(
          (bounds, coordinate) => bounds.extend(coordinate),
          new maplibregl.LngLatBounds(coordinates[0], coordinates[0])
        );
      }

      function setRouteData(coordinates) {
        if (!routeSource || !coordinates.length) return;
        routeSource.setData({
          type: 'Feature',
          properties: {},
          geometry: {
            type: 'LineString',
            coordinates: coordinates.length > 1 ? coordinates : [coordinates[0], coordinates[0]]
          }
        });
      }

      function routeCoordinatesFor(route) {
        if (route === 'full') return routeCoordinates;
        if (typeof route === 'number') {
          return routeCoordinates.slice(0, Math.max(1, route + 1));
        }
        return [routeCoordinates[0]];
      }

      function animateRouteFor(state) {
        if (!mapReady || !routeSource) return;
        const coordinates = routeCoordinatesFor(state.map.route);

        if (routeAnimationFrame) {
          cancelAnimationFrame(routeAnimationFrame);
          routeAnimationFrame = null;
        }

        if (
          reducedMotion ||
          state.map.route === 'full' ||
          coordinates.length < 2
        ) {
          setRouteData(coordinates);
          return;
        }

        const fixed = coordinates.slice(0, -1);
        const from = coordinates[coordinates.length - 2];
        const to = coordinates[coordinates.length - 1];
        const started = performance.now();
        const duration = 650;

        const frame = (now) => {
          const progress = Math.min(1, (now - started) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = [
            from[0] + (to[0] - from[0]) * eased,
            from[1] + (to[1] - from[1]) * eased
          ];
          setRouteData([...fixed, current]);

          if (progress < 1) {
            routeAnimationFrame = requestAnimationFrame(frame);
          } else {
            routeAnimationFrame = null;
          }
        };

        routeAnimationFrame = requestAnimationFrame(frame);
      }

      function mapPadding(state) {
        if (state.map.view === 'all') {
          return { top: 52, right: 46, bottom: 52, left: 46 };
        }

        switch (state.map.focus) {
          case 'orsay':
            return { top: 62, right: 118, bottom: 56, left: 44 };
          case 'louvre':
            return { top: 62, right: 44, bottom: 56, left: 118 };
          case 'orangerie':
            return { top: 96, right: 102, bottom: 42, left: 48 };
          default:
            return { top: 60, right: 60, bottom: 60, left: 60 };
        }
      }

      function updateMarkerState(state) {
        const focus = state.map.focus;
        const focusIndex = routeOrder.indexOf(focus);

        experience.querySelectorAll('[data-poi-key]').forEach((marker) => {
          const key = marker.getAttribute('data-poi-key');
          const index = routeOrder.indexOf(key);
          marker.classList.toggle('is-active', key === focus);
          marker.classList.toggle(
            'is-completed',
            focusIndex >= 0 && index >= 0 && index < focusIndex
          );
          marker.classList.toggle(
            'is-future',
            focusIndex >= 0 && index > focusIndex
          );
        });

        experience.querySelectorAll('[data-poi-jump]').forEach((card) => {
          card.classList.toggle('is-active', card.getAttribute('data-poi-jump') === focus);
        });
      }

      function updateMapState(state) {
        if (!mapReady || !map || !maplibregl) return;

        animateRouteFor(state);
        updateMarkerState(state);

        const coordinates = state.map.view === 'all'
          ? [...routeCoordinates, places.marmottan.center]
          : routeCoordinates;

        map.fitBounds(boundsFor(coordinates), {
          padding: mapPadding(state),
          maxZoom: state.map.view === 'all' ? 12.8 : 14.05,
          duration: reducedMotion ? 0 : 650,
          essential: false
        });
      }

      function activateStageState(key) {
        const state = stageStates[key];
        if (!state) return;

        activeStateKey = key;
        experience.setAttribute('data-active-stage', key);
        if (mapContainer) {
          mapContainer.setAttribute('data-stage-state', key);
          mapContainer.setAttribute('data-route-progress', String(state.map.route));
        }
        setMedia(state.media);
        setDecision(state);
        updateMapState(state);
      }

      function scrollToState(key) {
        const trackedItem = tracked.find((item) => item.key === key);
        trackedItem?.element.scrollIntoView({
          behavior: reducedMotion ? 'auto' : 'smooth',
          block: 'center'
        });
      }

      async function initMap() {
        if (mapReady || !mapContainer) return;

        try {
          maplibregl = await import('https://unpkg.com/maplibre-gl@6.10.0/dist/maplibre-gl.mjs');
          mapContainer.innerHTML = '';

          map = new maplibregl.Map({
            container: mapContainer,
            style: 'https://tiles.openfreemap.org/styles/liberty',
            center: [2.3299, 48.8614],
            zoom: 13.7,
            pitch: 28,
            bearing: -8,
            attributionControl: true,
            interactive: true
          });

          map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

          map.on('load', () => {
            map.addSource('editorial-route-plan', {
              type: 'geojson',
              data: {
                type: 'Feature',
                properties: {},
                geometry: {
                  type: 'LineString',
                  coordinates: routeCoordinates
                }
              }
            });

            map.addLayer({
              id: 'editorial-route-plan-line',
              type: 'line',
              source: 'editorial-route-plan',
              layout: {
                'line-cap': 'round',
                'line-join': 'round'
              },
              paint: {
                'line-color': '#526057',
                'line-width': 3,
                'line-opacity': 0.30,
                'line-dasharray': [1.5, 1.5]
              }
            });

            map.addSource('editorial-route', {
              type: 'geojson',
              data: {
                type: 'Feature',
                properties: {},
                geometry: {
                  type: 'LineString',
                  coordinates: [routeCoordinates[0], routeCoordinates[0]]
                }
              }
            });

            map.addLayer({
              id: 'editorial-route-line',
              type: 'line',
              source: 'editorial-route',
              layout: {
                'line-cap': 'round',
                'line-join': 'round'
              },
              paint: {
                'line-color': '#9a7146',
                'line-width': 5,
                'line-opacity': 0.98
              }
            });

            routeSource = map.getSource('editorial-route');

            Object.values(places).forEach((place) => {
              const marker = document.createElement('button');
              marker.type = 'button';
              marker.className = 'paris-map-marker';
              marker.setAttribute('data-poi-key', place.id);
              marker.setAttribute('aria-label', place.name + ' auf der Karte auswählen');
              marker.textContent = place.id === 'marmottan'
                ? 'O'
                : String(routeOrder.indexOf(place.id) + 1);
              if (place.id === 'marmottan') {
                marker.classList.add('paris-map-marker--optional');
              }

              marker.addEventListener('click', () => {
                const key = place.id;
                activateStageState(key);
                scrollToState(key);
              });

              new maplibregl.Marker({ element: marker, anchor: 'center' })
                .setLngLat(place.center)
                .addTo(map);
            });

            mapReady = true;
            updateMapState(stageStates[activeStateKey]);
          });
        } catch (error) {
          mapContainer.innerHTML =
            '<div class="paris-stage__map-placeholder"><span>Interaktive Karte konnte nicht geladen werden. Der Guide bleibt vollständig nutzbar.</span></div>';
          console.error('Paris map failed to initialize', error);
        }
      }

      if (mapContainer && 'IntersectionObserver' in window) {
        const mapObserver = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              initMap();
              mapObserver.disconnect();
            }
          },
          { rootMargin: '500px 0px' }
        );
        mapObserver.observe(mapContainer);
      } else {
        initMap();
      }

      const candidates = [...experience.querySelectorAll('[data-paris-story-copy] h2')];
      const tracked = candidates
        .map((element) => {
          const text = element.textContent?.trim() || '';
          const match = chapterStates.find((entry) => entry.match.test(text));
          return match ? { element, key: match.key } : null;
        })
        .filter(Boolean);

      experience.querySelectorAll('[data-poi-jump]').forEach((card) => {
        card.addEventListener('click', () => {
          const key = card.getAttribute('data-poi-jump');
          if (!key) return;
          activateStageState(key);
          scrollToState(key);
        });
      });

      function syncStoryState() {
        storyTicking = false;
        const anchorY = window.innerHeight * 0.58;
        let current = null;
        let nearestTop = Number.NEGATIVE_INFINITY;

        tracked.forEach((item) => {
          const top = item.element.getBoundingClientRect().top;
          if (top <= anchorY && top > nearestTop) {
            current = item;
            nearestTop = top;
          }
        });

        const nearBottom =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 32;
        if (nearBottom && tracked.length) {
          current = tracked[tracked.length - 1];
        }

        if (current) {
          if (activeStoryElement !== current.element) {
            activeStoryElement = current.element;
            activateStageState(current.key);
          }
        } else if (activeStoryElement !== null) {
          activeStoryElement = null;
          activateStageState('overview');
        }
      }

      function requestStorySync() {
        if (storyTicking) return;
        storyTicking = true;
        requestAnimationFrame(syncStoryState);
      }

      window.addEventListener('scroll', requestStorySync, { passive: true });
      window.addEventListener('resize', requestStorySync);

      activateStageState('overview');
      requestStorySync();
    }
  </script>
</BaseLayout>


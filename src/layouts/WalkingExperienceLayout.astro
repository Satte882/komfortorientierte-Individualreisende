---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ArticleMeta from '../components/content/ArticleMeta.astro';
import MethodologyNote from '../components/content/MethodologyNote.astro';
import SourceList from '../components/content/SourceList.astro';
import { walkingMapConfig } from '../config/maps';
import type { WalkingExperience } from '../types/walking-experience';

const { data, experience } = Astro.props as {
  data: any;
  experience: WalkingExperience;
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: new Date(data.datePublished).toISOString(),
  dateModified: new Date(data.dateReviewed).toISOString(),
  inLanguage: 'de-DE'
};

const clientMapConfig = walkingMapConfig;
const firstPoi = experience.pois[0];
---

<BaseLayout
  title={data.title}
  description={data.description}
  jsonLd={jsonLd}
  noindex={data.status !== 'published'}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@6.10.0/dist/maplibre-gl.css" />
  </Fragment>

  <Breadcrumbs items={[{ label: data.title }]} />

  <header class="walking-hero container">
    <div>
      <p class="eyebrow">Walking Guide · Experience Spike</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <ArticleMeta datePublished={data.datePublished} dateReviewed={data.dateReviewed} duration={data.duration} />
    </div>
    <div class="walking-hero__note">
      <span>{experience.pois.length} Stopps</span>
      <strong>{experience.subtitle}</strong>
      <p>Die Karte bleibt im Kontext. Beim Scrollen wächst die tatsächlich gegangene Route bis zum aktuellen Stopp.</p>
    </div>
  </header>

  <section
    class="walking-experience container"
    data-walking-experience
    data-active-stop={firstPoi?.id}
  >
    <div class="walking-experience__grid">
      <aside class="walking-stage" aria-label="Karte der Walking-Route">
        <div class="walking-stage__map" data-walking-map>
          <div class="walking-stage__placeholder">Karte wird geladen …</div>
        </div>
        <div class="walking-stage__status" aria-live="polite">
          <span data-stop-number>Stop 01</span>
          <strong data-stop-title>{firstPoi?.name}</strong>
          <p data-stop-context>{firstPoi?.shortContext}</p>
        </div>
      </aside>

      <article class="prose walking-story" data-walking-story>
        <slot />
      </article>
    </div>
  </section>

  <section class="prose walking-aftercare">
    <MethodologyNote />
    <SourceList sources={data.sources} />
  </section>

  <script is:inline type="module" define:vars={{ experience, clientMapConfig }}>
    const root = document.querySelector('[data-walking-experience]');

    if (root) {
      const mapContainer = root.querySelector('[data-walking-map]');
      const story = root.querySelector('[data-walking-story]');
      const numberNode = root.querySelector('[data-stop-number]');
      const titleNode = root.querySelector('[data-stop-title]');
      const contextNode = root.querySelector('[data-stop-context]');
      const steps = [...story.querySelectorAll('[data-walking-step]')];
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mobileQuery = window.matchMedia('(max-width: 760px)');

      let map;
      let maplibregl;
      let routeSource;
      let fullRouteCoordinates = [];
      let routeIndexes = [];
      let routeBounds;
      let activeIndex = 0;
      let renderedRouteIndex = 0;
      let routeAnimationFrame = null;
      let scrollTicking = false;

      function extractLineCoordinates(geojson) {
        const geometry =
          geojson?.type === 'FeatureCollection'
            ? geojson.features?.find((feature) =>
                feature?.geometry?.type === 'LineString' ||
                feature?.geometry?.type === 'MultiLineString'
              )?.geometry
            : geojson?.type === 'Feature'
              ? geojson.geometry
              : geojson;

        if (!geometry) return [];

        if (geometry.type === 'LineString') return geometry.coordinates || [];
        if (geometry.type === 'MultiLineString') return (geometry.coordinates || []).flat();
        return [];
      }

      function editorialRoute() {
        return experience.pois.map((poi) => poi.coordinates);
      }

      async function loadRoute() {
        try {
          const response = await fetch(experience.routeUrl, { credentials: 'same-origin' });
          if (!response.ok) throw new Error('Route HTTP ' + response.status);
          const geojson = await response.json();
          const coordinates = extractLineCoordinates(geojson);
          if (coordinates.length < 2) throw new Error('Route has no usable LineString');
          return coordinates;
        } catch (error) {
          if (experience.routeMode === 'editorial') return editorialRoute();
          throw error;
        }
      }

      function nearestRouteIndex(coordinate) {
        let bestIndex = 0;
        let bestDistance = Number.POSITIVE_INFINITY;

        fullRouteCoordinates.forEach((routeCoordinate, index) => {
          const dx = routeCoordinate[0] - coordinate[0];
          const dy = routeCoordinate[1] - coordinate[1];
          const distance = dx * dx + dy * dy;
          if (distance < bestDistance) {
            bestDistance = distance;
            bestIndex = index;
          }
        });

        return bestIndex;
      }

      function routeFeature(coordinates) {
        const safeCoordinates =
          coordinates.length > 1
            ? coordinates
            : [coordinates[0], coordinates[0]];

        return {
          type: 'Feature',
          properties: {},
          geometry: {
            type: 'LineString',
            coordinates: safeCoordinates
          }
        };
      }

      function setActiveRoute(index) {
        if (!routeSource || !fullRouteCoordinates.length) return;
        renderedRouteIndex = Math.max(0, Math.min(index, fullRouteCoordinates.length - 1));
        routeSource.setData(routeFeature(fullRouteCoordinates.slice(0, renderedRouteIndex + 1)));
        mapContainer?.setAttribute('data-active-route-index', String(renderedRouteIndex));
        mapContainer?.setAttribute('data-active-route-coordinate-count', String(renderedRouteIndex + 1));
      }

      function animateActiveRoute(targetIndex) {
        if (!routeSource) return;

        if (routeAnimationFrame) {
          cancelAnimationFrame(routeAnimationFrame);
          routeAnimationFrame = null;
        }

        if (reducedMotion || targetIndex <= renderedRouteIndex) {
          setActiveRoute(targetIndex);
          return;
        }

        const fromIndex = renderedRouteIndex;
        const distance = targetIndex - fromIndex;
        const started = performance.now();
        const duration = Math.min(700, 320 + distance * 5);

        const frame = (now) => {
          const progress = Math.min(1, (now - started) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          const index = Math.min(
            targetIndex,
            fromIndex + Math.max(1, Math.floor(distance * eased))
          );
          setActiveRoute(index);

          if (progress < 1) {
            routeAnimationFrame = requestAnimationFrame(frame);
          } else {
            routeAnimationFrame = null;
            setActiveRoute(targetIndex);
          }
        };

        routeAnimationFrame = requestAnimationFrame(frame);
      }

      function buildBounds(coordinates) {
        return coordinates.reduce(
          (bounds, coordinate) => bounds.extend(coordinate),
          new maplibregl.LngLatBounds(coordinates[0], coordinates[0])
        );
      }

      function cameraPadding(poi) {
        const mobile = mobileQuery.matches;
        const camera = mobile
          ? clientMapConfig.camera.mobile
          : clientMapConfig.camera.desktop;
        const base = camera.basePadding;
        const extra = camera.focusExtraPadding;
        const padding = { top: base, right: base, bottom: base, left: base };
        const center = routeBounds.getCenter();
        const [lng, lat] = poi.coordinates;

        if (lng >= center.lng) padding.left += extra;
        else padding.right += extra;

        const verticalExtra = Math.round(extra * 0.35);
        if (lat >= center.lat) padding.bottom += verticalExtra;
        else padding.top += verticalExtra;

        return padding;
      }

      function updateMarkers(index) {
        root.querySelectorAll('[data-walking-marker]').forEach((marker) => {
          const markerIndex = Number(marker.getAttribute('data-walking-marker'));
          marker.classList.toggle('is-completed', markerIndex < index);
          marker.classList.toggle('is-active', markerIndex === index);
          marker.classList.toggle('is-future', markerIndex > index);
        });
      }

      function updateStage(index, { animate = true } = {}) {
        const poi = experience.pois[index];
        if (!poi) return;

        activeIndex = index;
        root.setAttribute('data-active-stop', poi.id);
        mapContainer?.setAttribute('data-camera-stop', poi.id);
        if (numberNode) numberNode.textContent = 'Stop ' + String(index + 1).padStart(2, '0');
        if (titleNode) titleNode.textContent = poi.name;
        if (contextNode) contextNode.textContent = poi.shortContext;

        if (!map || !routeBounds) return;

        const targetRouteIndex = routeIndexes[index] ?? 0;
        if (animate) animateActiveRoute(targetRouteIndex);
        else setActiveRoute(targetRouteIndex);
        updateMarkers(index);

        const camera = mobileQuery.matches
          ? clientMapConfig.camera.mobile
          : clientMapConfig.camera.desktop;

        map.fitBounds(routeBounds, {
          padding: cameraPadding(poi),
          maxZoom: camera.maxZoom,
          duration: reducedMotion || !animate ? 0 : camera.durationMs,
          essential: false
        });
      }

      function activeStepFromViewport() {
        if (!steps.length) return 0;
        const line = window.innerHeight * (
          mobileQuery.matches
            ? clientMapConfig.scroll.mobileActivationLine
            : clientMapConfig.scroll.desktopActivationLine
        );

        let selected = 0;
        let nearest = Number.NEGATIVE_INFINITY;

        steps.forEach((step, index) => {
          const top = step.getBoundingClientRect().top;
          if (top <= line && top > nearest) {
            selected = index;
            nearest = top;
          }
        });

        return selected;
      }

      function syncFromScroll() {
        scrollTicking = false;
        const nextIndex = activeStepFromViewport();
        if (nextIndex !== activeIndex) updateStage(nextIndex);
      }

      function requestScrollSync() {
        if (scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(syncFromScroll);
      }

      async function initMap() {
        if (!mapContainer || !experience.pois.length) return;

        try {
          fullRouteCoordinates = await loadRoute();
          maplibregl = await import('https://unpkg.com/maplibre-gl@6.10.0/dist/maplibre-gl.mjs');
          routeBounds = buildBounds(fullRouteCoordinates);
          routeIndexes = experience.pois.map((poi) => nearestRouteIndex(poi.coordinates));

          mapContainer.innerHTML = '';

          const isMobile = mobileQuery.matches;
          map = new maplibregl.Map({
            container: mapContainer,
            style: clientMapConfig.styleUrl,
            center: experience.pois[0].coordinates,
            zoom: 13,
            attributionControl: true,
            interactive: !isMobile
          });

          if (!isMobile) {
            map.scrollZoom.disable();
            map.dragRotate.disable();
          }

          map.on('load', () => {
            map.addSource('walking-route-plan', {
              type: 'geojson',
              data: routeFeature(fullRouteCoordinates)
            });

            map.addLayer({
              id: 'walking-route-plan-line',
              type: 'line',
              source: 'walking-route-plan',
              layout: {
                'line-cap': 'round',
                'line-join': 'round'
              },
              paint: {
                'line-color': '#56645a',
                'line-width': 4,
                'line-opacity': 0.28,
                'line-dasharray': [1.4, 1.4]
              }
            });

            map.addSource('walking-route-active', {
              type: 'geojson',
              data: routeFeature([fullRouteCoordinates[0]])
            });

            map.addLayer({
              id: 'walking-route-active-line',
              type: 'line',
              source: 'walking-route-active',
              layout: {
                'line-cap': 'round',
                'line-join': 'round'
              },
              paint: {
                'line-color': '#9a7146',
                'line-width': 6,
                'line-opacity': 0.98
              }
            });

            routeSource = map.getSource('walking-route-active');

            experience.pois.forEach((poi, index) => {
              const marker = document.createElement('button');
              marker.type = 'button';
              marker.className = 'walking-map-marker';
              marker.textContent = String(index + 1);
              marker.setAttribute('data-walking-marker', String(index));
              marker.setAttribute('aria-label', poi.name + ' anzeigen');

              marker.addEventListener('click', () => {
                const step = steps[index];
                step?.scrollIntoView({
                  behavior: reducedMotion ? 'auto' : 'smooth',
                  block: 'center'
                });
                updateStage(index);
              });

              new maplibregl.Marker({ element: marker, anchor: 'center' })
                .setLngLat(poi.coordinates)
                .addTo(map);
            });

            updateStage(activeStepFromViewport(), { animate: false });
          });
        } catch (error) {
          console.error('Walking map failed to initialize', error);
          mapContainer.innerHTML =
            '<div class="walking-stage__error">Walking-Route konnte nicht geladen werden. Der Artikel bleibt vollständig lesbar.</div>';
          root.setAttribute('data-map-error', 'true');
        }
      }

      window.addEventListener('scroll', requestScrollSync, { passive: true });
      window.addEventListener('resize', requestScrollSync);
      mobileQuery.addEventListener?.('change', () => {
        requestScrollSync();
        if (map && routeBounds) updateStage(activeIndex, { animate: false });
      });

      initMap();
      requestScrollSync();
    }
  </script>
</BaseLayout>

<style>
  .walking-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, .7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .walking-hero h1 {
    margin: .35rem 0 1rem;
    max-width: 16ch;
  }

  .walking-hero__note {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .walking-hero__note span {
    display: block;
    margin-bottom: .35rem;
    color: var(--bronze);
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .walking-hero__note strong {
    display: block;
    color: var(--ink);
    font: 600 1.35rem/1.25 Georgia, serif;
  }

  .walking-hero__note p {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .walking-experience {
    padding-bottom: 5rem;
  }

  .walking-experience__grid {
    display: grid;
    grid-template-columns: minmax(420px, .95fr) minmax(0, 1.05fr);
    gap: clamp(2.2rem, 5vw, 5rem);
    align-items: start;
  }

  .walking-stage {
    position: sticky;
    top: 5rem;
    align-self: start;
    height: min(72vh, 680px);
    min-height: 480px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #e8e5dc;
    box-shadow: 0 18px 44px rgba(35, 37, 31, .08);
    z-index: 3;
  }

  .walking-stage__map {
    width: 100%;
    height: 100%;
  }

  .walking-stage__placeholder,
  .walking-stage__error {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 2rem;
    color: var(--muted);
    text-align: center;
  }

  .walking-stage__status {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: min(420px, calc(100% - 2rem));
    padding: .9rem 1rem;
    border: 1px solid rgba(255,255,255,.72);
    background: rgba(249,247,241,.94);
    box-shadow: 0 10px 30px rgba(33, 33, 27, .16);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  .walking-stage__status span {
    display: block;
    margin-bottom: .18rem;
    color: var(--bronze);
    font-size: .62rem;
    font-weight: 850;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .walking-stage__status strong {
    display: block;
    color: var(--ink);
    font: 600 1.12rem/1.2 Georgia, serif;
  }

  .walking-stage__status p {
    margin: .28rem 0 0;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.42;
  }

  .walking-story {
    width: 100%;
    margin: 0;
  }

  .walking-aftercare {
    margin-top: 0;
    padding-bottom: 4rem;
  }

  :global(.walking-map-marker) {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #5d675f;
    color: #fff;
    box-shadow: 0 4px 14px rgba(29, 35, 30, .24);
    font: 800 .72rem/1 system-ui, sans-serif;
    cursor: pointer;
    transition: transform .18s ease, background .18s ease, opacity .18s ease;
  }

  :global(.walking-map-marker.is-completed) {
    background: #83715b;
    opacity: .82;
  }

  :global(.walking-map-marker.is-active) {
    background: #9a7146;
    transform: scale(1.22);
    z-index: 4;
  }

  :global(.walking-map-marker.is-future) {
    background: #7a827c;
    opacity: .62;
  }

  :global(.maplibregl-ctrl-attrib) {
    font-size: 10px;
  }

  @media (max-width: 900px) {
    .walking-experience__grid {
      grid-template-columns: minmax(340px, .88fr) minmax(0, 1.12fr);
      gap: 2rem;
    }
  }

  @media (max-width: 760px) {
    .walking-hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 2rem;
      padding-bottom: 2.5rem;
    }

    .walking-experience {
      padding-inline: 0;
    }

    .walking-experience__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
    }

    .walking-stage {
      top: 4rem;
      height: clamp(240px, 38vh, 340px);
      min-height: 0;
      border-inline: 0;
      z-index: 8;
    }

    .walking-story {
      padding: 2rem var(--page-gutter, 1rem) 0;
    }

    .walking-stage__status {
      left: .65rem;
      right: .65rem;
      bottom: .65rem;
      max-width: calc(100% - 1.3rem);
      padding: .65rem .75rem;
    }

    .walking-stage__status p {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.walking-map-marker) {
      transition: none;
    }
  }
</style>

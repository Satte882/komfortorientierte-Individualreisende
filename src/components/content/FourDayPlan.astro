---
type Day = {
  code: string;
  title: string;
  duration: string;
  main: string;
  after: string;
  comfort: string;
  tone?: 'priority' | 'light' | 'flex';
};

const { days = [] } = Astro.props as { days: Day[] };
---

<section class="day-plan" aria-label="Vier-Tage-Plan">
  {days.map((day) => (
    <article class:list={['day-plan__card', `day-plan__card--${day.tone ?? 'priority'}`]}>
      <header class="day-plan__header">
        <div>
          <span class="day-plan__code">{day.code}</span>
          <h3>{day.title}</h3>
        </div>
        <span class="day-plan__duration">{day.duration}</span>
      </header>

      <div class="day-plan__body">
        <div>
          <span class="day-plan__label">Hauptblock</span>
          <p>{day.main}</p>
        </div>
        <div>
          <span class="day-plan__label">Danach</span>
          <p>{day.after}</p>
        </div>
      </div>

      <footer class="day-plan__comfort">
        <span class="day-plan__label">Komfortentscheidung</span>
        <p>{day.comfort}</p>
      </footer>
    </article>
  ))}
</section>

<style>
  .day-plan {
    display: grid;
    gap: .9rem;
    margin: 1.6rem 0 2rem;
  }

  .day-plan__card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      linear-gradient(135deg, rgba(255,255,255,.72), rgba(247,243,234,.78)),
      var(--paper);
    box-shadow: 0 10px 28px rgba(44, 39, 30, .055);
  }

  .day-plan__card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--bronze);
  }

  .day-plan__card--light::before {
    background: #73897a;
  }

  .day-plan__card--flex::before {
    background: #8a7760;
  }

  .day-plan__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.05rem 1.15rem .85rem 1.3rem;
    border-bottom: 1px solid rgba(83, 75, 61, .14);
  }

  .day-plan__code,
  .day-plan__label {
    display: block;
    color: var(--bronze);
    font-size: .62rem;
    font-weight: 850;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .day-plan__header h3 {
    margin: .2rem 0 0;
    font: 600 clamp(1.15rem, 2vw, 1.42rem)/1.2 Georgia, serif;
    color: var(--ink);
  }

  .day-plan__duration {
    flex: 0 0 auto;
    padding: .35rem .55rem;
    border: 1px solid rgba(83, 75, 61, .18);
    background: rgba(255,255,255,.62);
    color: var(--muted);
    font-size: .7rem;
    white-space: nowrap;
  }

  .day-plan__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .day-plan__body > div {
    min-width: 0;
    padding: .9rem 1.15rem .95rem 1.3rem;
  }

  .day-plan__body > div + div {
    border-left: 1px solid rgba(83, 75, 61, .14);
  }

  .day-plan p {
    margin: .28rem 0 0;
    color: var(--ink);
    font-size: .9rem;
    line-height: 1.5;
  }

  .day-plan__comfort {
    margin: 0;
    padding: .8rem 1.15rem .9rem 1.3rem;
    background: rgba(36, 56, 45, .055);
    border-top: 1px solid rgba(83, 75, 61, .14);
  }

  .day-plan__comfort p {
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .day-plan__header {
      align-items: center;
    }

    .day-plan__body {
      grid-template-columns: 1fr;
    }

    .day-plan__body > div + div {
      border-left: 0;
      border-top: 1px solid rgba(83, 75, 61, .12);
    }
  }
</style>

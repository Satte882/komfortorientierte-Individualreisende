---
interface Props {
  href: string;
  title: string;
  description: string;
  image?: string;
  kicker?: string;
  meta?: string;
}
const { href, title, description, image, kicker = 'Reiseauswahl', meta = '' } = Astro.props;
const placeholderSlug = href.split('/').filter(Boolean).pop() || 'article-card';
const isDemoImage = Boolean(image && image.includes('-editorial.svg'));
const placeholderComment = '<!-- PLACEHOLDER: real image pending, slug=' + placeholderSlug + ' -->';
---
<a class="article-card" href={href}>
  <div class="article-card__visual">
    {isDemoImage && <Fragment set:html={placeholderComment} />}
    {image ? (
      <img src={image} alt="" loading="lazy" data-demo-asset={isDemoImage ? 'true' : undefined} />
    ) : (
      <>
        <Fragment set:html={placeholderComment} />
        <div class="visual-placeholder" aria-hidden="true" data-placeholder-slug={placeholderSlug}></div>
      </>
    )}
  </div>
  <div class="article-card__body">
    <div class="article-card__topline">
      <span class="eyebrow">{kicker}</span>
      {meta && <span class="card-meta">{meta}</span>}
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="text-link">Auswahl ansehen <span aria-hidden="true">→</span></span>
  </div>
</a>
